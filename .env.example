# Cloud sync is optional. Without these two variables VProject runs fully
# offline/local-only (localStorage) and every feature still works.
#
# Fill them in from your Supabase project (Project Settings -> API) to enable
# multi-device sync. The anon key is safe to expose in a public static site —
# access is restricted by the Row Level Security policies in supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
